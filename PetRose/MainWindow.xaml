<Window x:Class="RoseDeskPet.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="300" Height="360" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ResizeMode="NoResize" ShowInTaskbar="True">
 <Grid x:Name="Root" Background="Transparent">
  <Border x:Name="Bubble" Visibility="Collapsed" Background="#FFFDFB" BorderBrush="#FFE19EAF" BorderThickness="2" CornerRadius="16" Padding="12,7" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="15,2,15,0" Panel.ZIndex="2"><TextBlock x:Name="BubbleText" Foreground="#FF553B46" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220"/></Border>
